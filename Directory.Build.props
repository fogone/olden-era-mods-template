<Project>
  <!-- What every mod of this repository shares: who made it and where its source is. They go into each mod's package
       (manifest.json) and from there into the catalog. In your copy, put yours. -->
  <PropertyGroup>
    <ModAuthor>fogone</ModAuthor>
    <ModSource>https://github.com/fogone/olden-era-mods-template</ModSource>
  </PropertyGroup>
</Project>
